# Provider: "openai" (OpenAI-compatible /chat/completions) or "anthropic" (/messages)
LLM_PROVIDER=openai

# API key for the selected provider (never commit real keys)
LLM_API_KEY=your-api-key-here

# Optional custom base URL (defaults to https://api.openai.com/v1 or https://api.anthropic.com/v1)
LLM_BASE_URL=https://api.openai.com/v1

# Default model and output token limit when not passed to complete()
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_MAX_TOKENS=1024

# Explicit HTTP timeouts in seconds
LLM_CONNECT_TIMEOUT=5.0
LLM_READ_TIMEOUT=30.0
LLM_WRITE_TIMEOUT=10.0
LLM_POOL_TIMEOUT=5.0

# Retry and backoff policy
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=16.0
LLM_JITTER_MAX_SECONDS=0.5
