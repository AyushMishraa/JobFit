# Provider: "gemini" (default), "openai", or "anthropic"
LLM_PROVIDER=gemini

# Google Gemini API key (GOOGLE_API_KEY and LLM_API_KEY are also supported)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional custom base URL (defaults to https://generativelanguage.googleapis.com/v1beta for gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Default Gemini model and output token limit when not passed to complete()
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_DEFAULT_MAX_TOKENS=1024

# Explicit HTTP timeouts in seconds
LLM_CONNECT_TIMEOUT=5.0
LLM_READ_TIMEOUT=30.0
LLM_WRITE_TIMEOUT=10.0
LLM_POOL_TIMEOUT=5.0

# Retry and backoff policy
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=16.0
LLM_JITTER_MAX_SECONDS=0.5
