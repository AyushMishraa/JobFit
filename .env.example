# Provider: "mistral" (default), "openai", or "anthropic"
LLM_PROVIDER=mistral

# Mistral AI API key (LLM_API_KEY is also supported and takes precedence if both are set)
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional custom base URL (defaults to https://api.mistral.ai/v1 for mistral)
LLM_BASE_URL=https://api.mistral.ai/v1

# Default Mistral model and output token limit when not passed to complete()
LLM_DEFAULT_MODEL=mistral-small-latest
LLM_DEFAULT_MAX_TOKENS=1024

# Explicit HTTP timeouts in seconds
LLM_CONNECT_TIMEOUT=5.0
LLM_READ_TIMEOUT=30.0
LLM_WRITE_TIMEOUT=10.0
LLM_POOL_TIMEOUT=5.0

# Retry and backoff policy
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=16.0
LLM_JITTER_MAX_SECONDS=0.5
